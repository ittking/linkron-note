{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "iterm",
  "version": "0.1.0",
  "identifier": "com.administrator.iterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "iterm",
        "label": "main",
        "width": 360,
        "height": 680,
        "minHeight": 680,
        "minWidth": 360,
        "center": true,
        "shadow": false,
        "skipTaskbar": true,
        "transparent": true,
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
