{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "linkron",
  "version": "1.1.0",
  "identifier": "com.administrator.linkron",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "linkron",
        "label": "main",
        "width": 360,
        "height": 780,
        "minHeight": 680,
        "minWidth": 360,
        "center": true,
        "shadow": false,
        "hiddenTitle": true,
        "transparent": true,
        "fullscreen": false,
        "decorations": false,
        "dragDropEnabled": false,
        "resizable": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        "default"
      ]
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRjg2NTQ1MDlFNzJFNUMKUldSY0x1Y0pSV1g0MzdxMkUvR1Q2ZnVDdTM3cnQwL0FPNHpvSjBwdmVxdU5tL0NpSTQ5Wm1QUEYK",
      "endpoints": [
        "https://github.com/ittking/linkron-note/releases/latest/download/latest.json"
      ]
    }
  }
}
